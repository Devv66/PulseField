# Copy this file to .env.local and fill in your Firebase Web App values.
# These are client-side Firebase configuration values, not server credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Required for the live Firebase path: Firebase App Check with reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional. Defaults to gemini-3.5-flash-lite when omitted.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
